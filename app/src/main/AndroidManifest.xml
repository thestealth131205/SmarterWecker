<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".NocturnApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NocTurn"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            System-Registrierung (CLAUDE.md Kernfunktion 11): die App meldet sich bei Android als
            Wecker-, Uhr- und Kalender-App an, damit sie z. B. von Sprachassistenten ("stelle einen
            Wecker") angesprochen und in den Einstellungen unter "Standard-Apps" als Uhr-/
            Kalender-App auswählbar wird.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NocTurn">
            <!--
                Bewusst KEIN eigener MAIN/LAUNCHER-Intent-Filter mehr hier: die drei
                activity-alias-Einträge unten (Uhr/Kalender/Wetter) übernehmen das, damit im
                App-Drawer nicht zusätzlich ein viertes, generisches "NocTurn"-Icon auftaucht.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <action android:name="android.intent.action.DISMISS_ALARM" />
                <action android:name="android.intent.action.SNOOZE_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_CLOCK" />
            </intent-filter>
        </activity>

        <!--
            System-App-Launcher-Icons (CLAUDE.md "NocTurn als System-App mit mehreren
            Launcher-Einstiegspunkten"): LetheOS ersetzt die LineageOS-Standardapps
            Uhr/Wecker und Kalender durch NocTurn, zeigt dafür aber bewusst weiterhin
            getrennte Launcher-Icons mit den gewohnten Namen statt eines einzigen
            "NocTurn"-Icons. Technisch drei activity-alias-Einträge auf dieselbe
            MainActivity (die App hat nur eine Activity mit internem Compose-NavHost) statt
            eigener Activity-Klassen — MainActivity erkennt anhand von
            `intent.component.className`, über welchen Alias sie gestartet wurde, und wählt
            passend die Start-Route (siehe MainActivity.kt).
        -->
        <activity-alias
            android:name=".ClockLauncherAlias"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:label="Uhr"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".CalendarLauncherAlias"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:label="Kalender"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".WeatherLauncherAlias"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:label="Wetter"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            Damit NocTurn im Android-"Zum Kalender hinzufügen"-Auswahlmenü erscheint, z. B. bei
            einem "Termin speichern"-Button in einer Kinoticket-/Buchungs-App (CLAUDE.md
            Kernfunktion 6). Android/andere Apps senden dafür ACTION_INSERT bzw. ACTION_EDIT auf
            den CalendarContract.Events-MIME-Typ.
        -->
        <activity
            android:name=".calendar.AddAppointmentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NocTurn">
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
        </activity>

        <!--
            Pflicht-Gegenstück zur Health-Connect-Berechtigungsanfrage (siehe
            PermissionsRationaleActivity.kt): ohne diese registrierte Aktivität bleibt die
            Berechtigungsvergabe für "Schritte" bei manchen Health-Connect-Versionen unzuverlässig.
        -->
        <activity
            android:name=".monitoring.PermissionsRationaleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NocTurn">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
            Zweiter, für Android 14+ (API 34) nötiger Einstiegspunkt derselben Datenschutz-Erklärung:
            auf neueren Geräten ist Health Connect ins System integriert und verlangt statt des
            ACTION_SHOW_PERMISSIONS_RATIONALE-Filters diese activity-alias mit
            VIEW_PERMISSION_USAGE/HEALTH_PERMISSIONS. Fehlt sie, bricht die Berechtigungsvergabe auf
            Android 14 still ab (gemeldeter Bug: "Health-Connect-Berechtigung wird trotz mehrfachem
            Versuch nicht erteilt"). Auf Android 13 (minSdk) bleibt der Filter oben maßgeblich.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".monitoring.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ringing.AlarmRingingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.NocTurn" />

        <activity
            android:name=".emergency.EmergencyAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.NocTurn" />

        <!--
            Systemweiter Timer-Einstiegspunkt (CLAUDE.md Kernfunktion: Stoppuhr/Timer-Symbole im
            Wecker-Screen statt der bisherigen Wetter-/Kalender-Icons, die bereits über die untere
            Tab-Leiste erreichbar sind). `SET_TIMER` ist dieselbe Standard-Aktion, über die z. B.
            Google Assistant ("stelle einen Timer über 10 Minuten") Timer-Apps anspricht.
        -->
        <activity
            android:name=".timer.TimerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NocTurn">
            <intent-filter>
                <action android:name="android.intent.action.SET_TIMER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".calendar.AppointmentReminderReceiver"
            android:exported="false" />

        <!--
            Vorprüfung vor dem automatischen Schicht-Wecker sowie Wieder-Klingeln nach ohne
            Bewegung gelöstem Notfall-Puzzle (siehe AlarmScheduler/AutomaticShiftRetryScheduler).
        -->
        <receiver
            android:name=".monitoring.PreAlarmCheckReceiver"
            android:exported="false" />

        <!--
            Zusätzliche, über 10 Minuten verteilte Standort-Vorprüfung (siehe
            PreAlarmLocationCheckService) neben der kürzeren, rein sensorbasierten Vorprüfung oben.
        -->
        <receiver
            android:name=".monitoring.PreAlarmLocationCheckReceiver"
            android:exported="false" />

        <receiver
            android:name=".monitoring.AutoShiftRetryReceiver"
            android:exported="false" />

        <receiver
            android:name=".timer.TimerCompletionReceiver"
            android:exported="false" />

        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Homescreen-Widgets (CLAUDE.md Kernfunktion 7): Uhr-Widget und Kalender-/Termine-Widget. -->
        <receiver
            android:name=".widget.ClockWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="de.letheapp.nocturn.widget.ACTION_CLOCK_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <!--
            Fragt beim Hinzufügen des Uhr-Widgets ab, welcher Wetter-Ort angezeigt werden soll,
            falls mehrere Orte angelegt sind (siehe ClockWidgetConfigureActivity). Android startet
            diese Activity für JEDES Hinzufügen des Widgets, daher der sofortige, unsichtbare
            Abschluss darin, wenn es ohnehin nur den Hauptort gibt.
        -->
        <activity
            android:name=".widget.ClockWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.NocTurn">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.CalendarWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <service
            android:name=".ringing.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".monitoring.PostAlarmMonitoringService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".emergency.EmergencyAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".monitoring.PreAlarmMovementCheckService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".monitoring.PreAlarmLocationCheckService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".monitoring.AutoShiftRetryService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".timer.TimerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            NocturnApplication initialisiert WorkManager selbst on-demand (Configuration.Provider
            mit HiltWorkerFactory, siehe NocturnApplication.kt) statt über den automatischen
            App-Startup-Initializer der work-runtime-Bibliothek — der Initializer-Eintrag aus deren
            Manifest muss daher explizit entfernt werden, sonst schlägt lintVitalRelease fehl.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Für die Fotos des Foto-Imports (Kernfunktion 5): liefert eine content://-Uri an die Kamera-App. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
