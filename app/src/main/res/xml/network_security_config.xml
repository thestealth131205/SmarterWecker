<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ioBroker-Adapter (iosync) läuft typischerweise über HTTP im lokalen Netz/LAN -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
